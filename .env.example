# Copia este archivo a .env.local solo para desarrollo en tu equipo.
# En Vercel define estas variables en Settings → Environment Variables (nunca en Git).

# Clave del administrador (obligatoria, mínimo 12 caracteres).
ADMIN_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Cadena de conexión de Vercel Postgres (Storage → Postgres → Connect).
# Vercel la crea como POSTGRES_URL al conectar la base de datos al proyecto.
POSTGRES_URL=postgres://usuario:clave@host/basedatos?sslmode=require
