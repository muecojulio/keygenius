{
  "name": "keygenius",
  "version": "2.0.0",
  "private": true,
  "description": "Gestión centralizada de licencias (Next.js App Router + Vercel Postgres).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib tests scripts/dev.mjs next.config.ts vitest.config.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "indices": "node scripts/analizar-indices.mjs"
  },
  "dependencies": {
    "next": "^16.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
